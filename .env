# ==============================================================================
# SMARTMARKET - VARIABLES DE ENTORNO GLOBALES
# ==============================================================================

# Tipo de Base de Datos ('postgres' para Docker/Producción, 'sqlite' para ejecución local directa sin Docker)
DB_TYPE=sqlite

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=smartmarket
DB_PASSWORD=smartmarket_secret
DB_NAME=smartmarket_db

# Configuración de Redis (Caché y Concurrencia)
REDIS_HOST=localhost
REDIS_PORT=6379

# Configuración del Backend (NestJS)
PORT=4000
JWT_SECRET=smartmarket_super_secret_jwt_key_2026
JWT_EXPIRATION=24h
NODE_ENV=development

# Configuración del Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
